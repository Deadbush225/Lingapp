PORT=4000

# ── MongoDB ────────────────────────────────────────────────────────
# Connection string for the triage case queue (e.g. mongodb+srv://user:pass@cluster.mongodb.net/triage)
MONGODB_URI=

# ── LLM: OpenRouter ──────────────────────────────────────────────
# Primary LLM provider for symptom analysis
LLM_PROVIDER=openrouter
# Your OpenRouter API key (https://openrouter.ai/keys)
LLM_API_KEY=
# OpenRouter model identifier (e.g., openai/gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-2.0-flash-lite)
LLM_MODEL=openai/gpt-4o-mini

# ── Agora (RTC + Conversational AI Engine) ──────────────────────
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_CAE_ENABLED=false
# Override LLM endpoint for the CAE (defaults to OpenRouter when LLM_PROVIDER=openrouter)
AGORA_CAE_LLM_URL=
# Override LLM API key for the CAE (defaults to LLM_API_KEY)
AGORA_CAE_LLM_API_KEY=
# Override LLM model for the CAE (defaults to LLM_MODEL)
AGORA_CAE_LLM_MODEL=
AGORA_CAE_SYSTEM_MESSAGE=You are a helpful medical intake voice assistant.
AGORA_CAE_GREETING_MESSAGE=Hello, how can I help you today?
AGORA_CAE_FAILURE_MESSAGE=Sorry, I am having trouble understanding. Please try again.
AGORA_CAE_ASR_LANGUAGE=en-US
AGORA_CAE_IDLE_TIMEOUT=120
AGORA_CAE_AGENT_RTC_UID=0

# ── TTS: Azure Speech (primary CAE TTS vendor) ──────────────────
# The CAE uses 'microsoft' as the TTS vendor with the credentials below
AGORA_CAE_TTS_VENDOR=microsoft
# Auto-populated from AZURE_SPEECH_* vars when empty — you can override here:
AGORA_CAE_TTS_PARAMS_JSON={}
# Azure Speech Service credentials
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_VOICE_NAME=en-US-AvaMultilingualNeural
AZURE_SPEECH_DEFAULT_LOCALE=en-US

# ── Agora Secure Tokens ──────────────────────────────────────────
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# ── Cloudflare Turnstile ─────────────────────────────────────────
CLOUDFLARE_SECRET_KEY=your_cloudflare_secret_key_here
