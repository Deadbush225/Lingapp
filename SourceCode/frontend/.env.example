# ── API ──────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:4000

# ── Agora RTC (required for STT — replaces browser Web Speech API) ──
VITE_AGORA_APP_ID=
VITE_AGORA_CHANNEL=triage-room
VITE_AGORA_TOKEN=

# ── Agora Conversational AI Engine (optional) ────────────────────
# Enables follow-up questions via the CAE agent (requires AGORA_CAE_ENABLED=true on backend)
VITE_ENABLE_CONVERSATIONAL_AI=false
